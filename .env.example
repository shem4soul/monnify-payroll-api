# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Infrastructure (matches docker-compose.yml when running the API on your machine) ---
DATABASE_URL=postgres://payroll:payroll@localhost:5432/payroll
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=1h

# --- First admin (used by `npm run seed:admin`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-now

# --- Monnify (sandbox) ---
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=your_api_key
MONNIFY_SECRET_KEY=your_secret_key
# Wallet account number that funds disbursements (NOT the contract code)
MONNIFY_WALLET_ACCOUNT_NUMBER=your_wallet_account_number
